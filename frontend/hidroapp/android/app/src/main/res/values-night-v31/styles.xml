<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: el sistema dibuja por su cuenta el ícono de la app en el
         arranque. Se deja el fondo azul y el ícono transparente para que solo
         se vea la animación de WelcomeScreen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
