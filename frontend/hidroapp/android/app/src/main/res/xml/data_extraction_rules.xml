<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior: no se respalda nada en la nube ni se copia a otro
     teléfono. La sesión cifrada no se puede descifrar fuera del equipo donde
     se creó (ver allowBackup en AndroidManifest.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
