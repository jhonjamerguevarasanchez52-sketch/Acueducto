# Copia este archivo como .env y llena los valores. Nunca subas el .env real.

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Obligatorio en producción: orígenes permitidos separados por coma (panel web).
CORS_ORIGIN=https://hidro-admin.onrender.com

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=clave_anon_publica
SUPABASE_SERVICE_KEY=clave_service_role_secreta

# --- Correo (Brevo) ---
BREVO_API_KEY=
# Remitente verificado en Brevo.
EMAIL_USER=
EMAIL_SENDER_NAME=Acueducto Campo Amor
LOGO_URL=

# --- Asistente GOTA (Groq) ---
GROQ_API_KEY=

# --- Pagos Wompi ---
WOMPI_AMBIENTE=test
WOMPI_CURRENCY=COP
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_INTEGRITY_KEY=test_integrity_...
WOMPI_EVENTS_SECRET=test_events_...
WOMPI_FEE_RATE=0.0265
WOMPI_FIXED_FEE_COP=700
WOMPI_FEE_IVA_RATE=0.19

# --- Tareas automáticas (pg_cron) ---
# Secreto compartido con Supabase para /api/tareas/diarias y /api/interno/*.
# Genera uno largo, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Protección de códigos de 6 dígitos (opcional) ---
# Secreto con el que se firman los códigos de acceso, verificación y
# recuperación antes de guardarlos. Si se deja vacío se usa SUPABASE_SERVICE_KEY.
# Cambiarlo invalida los códigos vigentes (duran 15 minutos).
CODIGOS_SECRET=
