{
  "info": {
    "name": "HIDROAPP - API Acueducto Campo Amor",
    "description": "Colección de pruebas de la API REST del Acueducto Veredal Campo Amor.\n\nUso rápido:\n1. Ajusta la variable de colección `baseUrl` (por defecto http://localhost:3000).\n2. Ejecuta `Auth > Login` con un usuario final: guarda el token en `token`.\n3. Ejecuta `Auth > Login (admin)` con un administrador: guarda el token en `adminToken`.\n4. El resto de peticiones usan esos tokens automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "correo", "value": "usuario@correo.com" },
    { "key": "password", "value": "ClaveSegura1" },
    { "key": "correoAdmin", "value": "admin@correo.com" },
    { "key": "passwordAdmin", "value": "ClaveAdmin1" },
    { "key": "userId", "value": "" },
    { "key": "facturaId", "value": "" },
    { "key": "pagoId", "value": "" },
    { "key": "averiaId", "value": "" },
    { "key": "notificacionId", "value": "" },
    { "key": "tarifaId", "value": "" },
    { "key": "corteId", "value": "" }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "GET /",
          "request": { "method": "GET", "url": "{{baseUrl}}/" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/registro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Torres\"\n}" },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "POST /api/auth/verificar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"codigo\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/verificar"
          }
        },
        {
          "name": "POST /api/auth/reenviar-codigo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/reenviar-codigo"
          }
        },
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.session && j.session.access_token) {",
                  "  pm.collectionVariables.set('token', j.session.access_token);",
                  "  console.log('token guardado');",
                  "}",
                  "if (j.user && j.user.id) pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST /api/auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.session && j.session.access_token) {",
                  "  pm.collectionVariables.set('adminToken', j.session.access_token);",
                  "  console.log('adminToken guardado');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correoAdmin}}\",\n  \"password\": \"{{passwordAdmin}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST /api/auth/solicitar-recuperacion",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/solicitar-recuperacion"
          }
        },
        {
          "name": "POST /api/auth/resetear-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"codigo\": \"123456\",\n  \"nuevaPassword\": \"NuevaClave1\"\n}" },
            "url": "{{baseUrl}}/api/auth/resetear-password"
          }
        }
      ]
    },
