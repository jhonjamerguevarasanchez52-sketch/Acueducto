# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.

SUPABASE_URL=https://xxxxxxxx.supabase.co

# Clave pública (anon / publishable). Se usa para el login y las consultas
# de usuario respetando la RLS.
SUPABASE_KEY=

# Clave secreta (service_role). Salta la RLS: úsala solo en el backend.
SUPABASE_SERVICE_KEY=

PORT=3000

# Opcional: lista de orígenes permitidos separados por comas.
# Si se omite, se permite cualquier origen (solo recomendable en desarrollo).
# CORS_ORIGIN=http://localhost:5173,https://miapp.com
